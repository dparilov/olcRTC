# olcRTC server secrets file
# Copy to /opt/olcrtc.secrets and set permissions: chmod 600
# NEVER commit actual values to repository

OLCRTC_MASTER_SECRET=<your-shared-setup-secret>
OLCRTC_OAUTH_TOKEN=<your-yandex-disk-oauth-token>

# Uncomment during master secret rotation:
# OLCRTC_PREVIOUS_SECRET=<old-secret-during-rotation-window>
